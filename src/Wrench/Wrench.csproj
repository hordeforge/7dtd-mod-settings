<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Wrench</AssemblyName>
    <RootNamespace>Wrench</RootNamespace>
    <DebugType>none</DebugType>
    <!-- The audit has nothing to read here: this project declares no
         PackageReference, and the game assemblies and Harmony arrive by
         path from the install (below). It would still fetch the advisory
         database on every restore, and an unreachable database is NU1900,
         a warning TreatWarningsAsErrors turns into a failed build on a
         machine that builds offline. -->
    <NuGetAudit>false</NuGetAudit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- the game logger (Log.Out etc.) lives in its own assembly -->
    <Reference Include="LogLibrary">
      <HintPath>$(GameManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
